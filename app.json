{
  "expo": {
    "name": "CoffeeShot",
    "slug": "coffeeshot-test-website",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "coffeeshot",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0A09"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "CoffeeShot utilise la caméra pour le cadrage et la capture de photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0A09",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0B0A09",
      "name": "CoffeeShot — test caméra",
      "shortName": "CoffeeShot"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "CoffeeShot utilise la caméra pour le cadrage et la capture de photos.",
          "microphonePermission": "CoffeeShot n'enregistre pas de son, mais le navigateur peut demander l'accès micro.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ]
  }
}
