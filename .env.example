# CoffeeShot browser SDK origin (web). Default: https://coffeeshot-sdk.pages.dev
# The page dynamically imports `${EXPO_PUBLIC_SDK_ORIGIN}/sdk.mjs`.
EXPO_PUBLIC_SDK_ORIGIN=https://coffeeshot-sdk.pages.dev

# Optional backend forwarded to createClient({ apiUrl, analyzePath }).
# When unset, the SDK runs a local mock analysis.
# Example: https://api.example.com
EXPO_PUBLIC_API_URL=

# Path appended to the API origin. Default: /analyze
EXPO_PUBLIC_ANALYZE_PATH=/analyze
